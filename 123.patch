-
-  for(n=0; n<N; n++){
-    pid = fork();
-    if(pid < 0)
-      break;
-    if(pid == 0)
-      exit(0);
-  }
-
-  if (n == 0) {
-    printf("%s: no fork at all!\n", s);
-    exit(1);
-  }
-
-  if(n == N){
-    printf("%s: fork claimed to work 1000 times!\n", s);
-    exit(1);
-  }
-
-  for(; n > 0; n--){
-    if(wait(0) < 0){
-      printf("%s: wait stopped early\n", s);
-      exit(1);
-    }
-  }
